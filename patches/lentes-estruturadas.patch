+
+test("recorded lenses unblock the advance, and survive as structured state", () => {
+  toPhase2Stamped();
+  writeCoverageMatrix(workspace);
+  assert.strictEqual(engine.advancePhase(3).ok, true);
+
+  const act = engine.getPhaseState()!.activatedLenses!;
+  assert.ok(act, "activation must persist as a field, not as prose to be grepped");
+  assert.strictEqual(act.universal.length, 7);
+  assert.strictEqual(
+    act.conditional.length + act.notActivated.length,
+    CONDITIONAL_LENSES.length,
+    "all 12 conditional lenses accounted for"
+  );
+});
